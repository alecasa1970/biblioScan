# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA faça commit do arquivo ".env" (ele contém segredos).

# --- WhatsApp Cloud API (Meta) ---
# Token de acesso (temporario de teste ou permanente) gerado no Meta App Dashboard
WHATSAPP_TOKEN=

# ID do numero de telefone do WhatsApp Business (Meta App Dashboard > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# Token que voce escolhe e usa para validar o webhook (qualquer string secreta sua)
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

# Versao da Graph API (opcional, tem um default no codigo)
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# Modelo usado para analisar as fotos. claude-opus-5 e o mais capaz (mais caro);
# para reduzir custo por foto, considere claude-sonnet-5 ou claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Servidor ---
PORT=8080
